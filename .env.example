# ClaimCheck Environment Variables

# App
APP_NAME=ClaimCheck
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://claimcheck:claimcheck@localhost:5432/claimcheck
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600
CACHE_MAX_SIZE=10000

# JWT / Auth
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
API_KEY_PREFIX=cck_

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_FREE=20/minute
RATE_LIMIT_PRO=200/minute
RATE_LIMIT_ENTERPRISE=2000/minute

# ML Models
NLI_MODEL_NAME=MoritzLaurer/DeBERTa-v3-large-mnli-fever-anli-ling-wanli
NLI_MODEL_SECONDARY=MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
DEVICE=cpu
MODEL_QUANTIZATION=false
USE_ENSEMBLE=true

# Verification Settings
DEFAULT_TOP_K=3
MAX_SOURCE_LENGTH=100000
MAX_SOURCES=50
CHUNK_SIZE=500
CHUNK_OVERLAP=50
MAX_CLAIMS_PER_REQUEST=100

# Streaming
ENABLE_STREAMING=true
STREAM_CHUNK_SIZE=1

# Webhooks
WEBHOOK_TIMEOUT_SECONDS=30
WEBHOOK_MAX_RETRIES=3

# Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# Monitoring
ENABLE_METRICS=true
METRICS_PATH=/metrics

# Frontend URL (for CORS + API docs)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
