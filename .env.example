# ClaimCheck Environment Variables
# Copy to backend/.env (or export in your shell) and adjust.

# ── App ──
APP_NAME=ClaimCheck
ENVIRONMENT=development          # development | staging | production | test
DEBUG=true
LOG_LEVEL=INFO

# ── API ──
API_HOST=0.0.0.0
API_PORT=8000
# Leave empty for no prefix. "/" is invalid in FastAPI and is normalised to "".
API_PREFIX=

# ── CORS ──
# Comma-separated list, or "*" for all. NOTE: with "*" the server disables
# credentialed CORS, because browsers reject `Allow-Origin: *` with credentials.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ── Database ──
# SQLite needs no server and is the default. Postgres needs the asyncpg driver.
DATABASE_URL=sqlite+aiosqlite:///./claimcheck.db
# DATABASE_URL=postgresql+asyncpg://claimcheck:claimcheck@localhost:5432/claimcheck
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
PERSIST_VERIFICATIONS=true

# ── Redis (optional) ──
# If unreachable, the app falls back to an in-process LRU cache automatically.
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600
CACHE_MAX_SIZE=512

# ── JWT / Auth ──
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
API_KEY_PREFIX=cck_

# ── Rate Limiting ──
RATE_LIMIT_ENABLED=false
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_FREE=20/minute
RATE_LIMIT_PRO=200/minute
RATE_LIMIT_ENTERPRISE=2000/minute

# ── ML Models ──
# MiniLM cross-encoder: ~90MB quantized, runs on a free CPU instance.
# DeBERTa-v3-large (the old default here) is ~1.6GB and WILL be OOM-killed.
NLI_MODEL_NAME=cross-encoder/nli-MiniLM2-L6-H768
NLI_MODEL_SECONDARY=cross-encoder/nli-MiniLM2-L6-H768
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
DEVICE=cpu
MODEL_QUANTIZATION=true
USE_ENSEMBLE=false
USE_CROSS_ENCODER_RERANK=false

# Some NLI checkpoints only report LABEL_0/LABEL_1/... If every verdict comes
# back UNVERIFIABLE, set the real order here (comma-separated).
# NLI_LABEL_ORDER=contradiction,entailment,neutral

# ── Inference tuning (the free-tier knobs) ──
NLI_MAX_LENGTH=256               # 512 roughly doubles latency
NLI_BATCH_SIZE=8                 # claims per forward pass
TORCH_NUM_THREADS=1              # >1 thrashes on a fractional vCPU
MODEL_WARMUP=true                # pay lazy-init cost at boot, not in a request
MAX_CONCURRENT_INFERENCES=1      # hard ceiling on simultaneous model work

# ── Retrieval ──
ENABLE_SEMANTIC_RETRIEVAL=true   # set false on <512MB instances (BM25 only)
RETRIEVER_CACHE_SIZE=8
BM25_WEIGHT=0.5
SEMANTIC_WEIGHT=0.5

# ── Verification Settings ──
DEFAULT_TOP_K=3
MAX_SOURCE_LENGTH=100000
MAX_SOURCES=50
CHUNK_SIZE=500
CHUNK_OVERLAP=50
MAX_CLAIMS_PER_REQUEST=100

# ── Streaming ──
ENABLE_STREAMING=true
STREAM_CHUNK_SIZE=1

# ── Webhooks ──
WEBHOOK_TIMEOUT_SECONDS=30
WEBHOOK_MAX_RETRIES=3

# ── Storage ──
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# ── Monitoring ──
ENABLE_METRICS=true
METRICS_PATH=/metrics

# ── Frontend ──
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
